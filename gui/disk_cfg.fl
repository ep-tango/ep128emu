          } {
            Fl_Input sdExtImageFileValuator {
              callback {{
  try {
    if (gui.config.sdext.imageFile != o->value()) {
      gui.config.sdext.imageFile = o->value();
      gui.config.sdCardImageChanged = true;
    }
  }
  catch (std::exception& e) {
    gui.errorMessage(e.what());
