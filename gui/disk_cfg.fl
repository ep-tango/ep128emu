                       "Select disk image file")) {
      gui.config["floppy.a.imageFile"] = tmp;
      gui.rememberDiskImage(tmp);
      floppyAImageFileValuator->value(tmp.c_str());
    }
  }
  catch (std::exception& e) {
    gui.errorMessage(e.what());
  }
}}
