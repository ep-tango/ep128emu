  SetOutPath "$INSTDIR\licenses\runtime\sdl12-compat"
  File /oname=LICENSE.txt "${EP128EMU_STAGE}\licenses\runtime\sdl12-compat\LICENSE.txt"
  SetOutPath "$INSTDIR"
  File /oname=lua53.dll "${EP128EMU_STAGE}\lua53.dll"
  File /oname=makecfg.exe "${EP128EMU_STAGE}\makecfg.exe"
  SetOverwrite off
  SetOutPath "$INSTDIR\roms"
  File /oname=asmon15.rom "${EP128EMU_STAGE}\roms\asmon15.rom"
  File /oname=basic20.rom "${EP128EMU_STAGE}\roms\basic20.rom"
