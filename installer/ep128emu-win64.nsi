  Delete "$INSTDIR\IMPORTS.json"
  Delete "$INSTDIR\RUN-SOFTWARE.cmd"
  Delete "$INSTDIR\RUN-WIN7.cmd"
  SectionIn RO
  SetOutPath "$INSTDIR"
  SetShellVarContext all
  SetRegView 64
  StrCpy $HadExe "0"
  IfFileExists "$INSTDIR\ep128emu.exe" 0 +2
  StrCpy $HadExe "1"
  CreateDirectory "$INSTDIR\config"
  CreateDirectory "$INSTDIR\config\cpc"
  CreateDirectory "$INSTDIR\config\ep128brd"
  CreateDirectory "$INSTDIR\config\ep128esp"
  CreateDirectory "$INSTDIR\config\ep128hun"
  CreateDirectory "$INSTDIR\config\ep128uk"
  CreateDirectory "$INSTDIR\config\ep64"
  CreateDirectory "$INSTDIR\config\tvc"
  CreateDirectory "$INSTDIR\config\zx"
  CreateDirectory "$INSTDIR\demo"
  CreateDirectory "$INSTDIR\disk"
  CreateDirectory "$INSTDIR\files"
  CreateDirectory "$INSTDIR\roms"
  CreateDirectory "$INSTDIR\snapshot"
  CreateDirectory "$INSTDIR\tape"
  SetOverwrite on
  SetOutPath "$INSTDIR"
  File /oname=7z.dll "${EP128EMU_STAGE}\7z.dll"
  SetOutPath "$INSTDIR\BetaDisk"
  File /oname=TRDOS-5.03.rom "${EP128EMU_STAGE}\BetaDisk\TRDOS-5.03.rom"
