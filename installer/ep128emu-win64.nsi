  SetOutPath "$INSTDIR"
  File /oname=tapeedit.exe "${EP128EMU_STAGE}\tapeedit.exe"
  File /oname=zlib1.dll "${EP128EMU_STAGE}\zlib1.dll"
  SetOutPath "$INSTDIR"
  WriteUninstaller "$INSTDIR\uninstall.exe"
  CreateDirectory "$SMPROGRAMS\EP128emu x64"
  CreateShortcut "$SMPROGRAMS\EP128emu x64\EP128emu.lnk" "$INSTDIR\ep128emu.exe"
  CreateShortcut "$SMPROGRAMS\EP128emu x64\Spectrum.lnk" "$INSTDIR\ep128emu.exe" "-zx"
  CreateShortcut "$SMPROGRAMS\EP128emu x64\Amstrad CPC.lnk" "$INSTDIR\ep128emu.exe" "-cpc"
  CreateShortcut "$SMPROGRAMS\EP128emu x64\Videoton TVC.lnk" "$INSTDIR\ep128emu.exe" "-tvc"
  CreateShortcut "$SMPROGRAMS\EP128emu x64\Tape editor.lnk" "$INSTDIR\tapeedit.exe"
  CreateShortcut "$SMPROGRAMS\EP128emu x64\Configuration utility.lnk" "$INSTDIR\makecfg.exe"
  CreateShortcut "$SMPROGRAMS\EP128emu x64\Uninstall.lnk" "$INSTDIR\uninstall.exe"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\ep128emu-custom-x64" "DisplayName" "EP128emu 2.2.2 x64"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\ep128emu-custom-x64" "UninstallString" "$\"$INSTDIR\uninstall.exe$\""
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\ep128emu-custom-x64" "InstallLocation" "$INSTDIR"
SectionEnd
Section "Create machine presets on first installation" SecConfig
  SectionIn RO
  SetOutPath "$INSTDIR"
  StrCmp $HadExe "1" skipConfig
  IfFileExists "$INSTDIR\config\cpc\*.cfg" skipConfig
  IfFileExists "$INSTDIR\config\ep128brd\*.cfg" skipConfig
  IfFileExists "$INSTDIR\config\ep128esp\*.cfg" skipConfig
  IfFileExists "$INSTDIR\config\ep128hun\*.cfg" skipConfig
  IfFileExists "$INSTDIR\config\ep128uk\*.cfg" skipConfig
  IfFileExists "$INSTDIR\config\ep64\*.cfg" skipConfig
  IfFileExists "$INSTDIR\config\tvc\*.cfg" skipConfig
  IfFileExists "$INSTDIR\config\zx\*.cfg" skipConfig
  ExecWait '"$INSTDIR\makecfg.exe" -p "$INSTDIR"' $SetupExit
  IntCmp $SetupExit 0 skipConfig configFail configFail
  configFail:
  MessageBox MB_ICONSTOP "Machine preset configuration failed (code $SetupExit)."
  Abort "Machine presets were not generated"
  skipConfig:
SectionEnd
Section "Uninstall"
  SetShellVarContext all
  SetRegView 64
  Delete "$SMPROGRAMS\EP128emu x64\*.lnk"
  RMDir "$SMPROGRAMS\EP128emu x64"
  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\ep128emu-custom-x64"
