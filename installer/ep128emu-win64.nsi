  File /oname=zt19hfnt.rom "${EP128EMU_STAGE}\roms\zt19hfnt.rom"
  File /oname=zt19hun.rom "${EP128EMU_STAGE}\roms\zt19hun.rom"
  File /oname=zt19uk.rom "${EP128EMU_STAGE}\roms\zt19uk.rom"
