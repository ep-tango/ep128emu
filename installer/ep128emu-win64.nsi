; Current ep128emu 2.2.2 canonical installer payload, source-maintained.
; Requires explicit stage and output definitions (see ep128emu.nsi).
Unicode True
Target amd64-unicode
Name "EP128emu 2.2.2 x64"
OutFile "${EP128EMU_OUTFILE}"
InstallDir "$PROGRAMFILES64\ep128emu-custom-x64"
RequestExecutionLevel admin
SetCompressor /SOLID lzma
!include "MUI2.nsh"
!define MUI_ABORTWARNING
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "${EP128EMU_STAGE}\COPYING"
!define MUI_PAGE_CUSTOMFUNCTION_LEAVE CheckExistingDirectory
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"
Var HadExe
Var SetupExit
Var ExistingDir
Function .onInit
  SetRegView 64
  ReadRegStr $ExistingDir HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\ep128emu-custom-x64" "InstallLocation"
  StrCmp $ExistingDir "" noInstalledPath
  StrCpy $INSTDIR $ExistingDir
  noInstalledPath:
FunctionEnd
Function CheckExistingDirectory
  StrCmp $ExistingDir "" correctLocation
  StrCmp $ExistingDir $INSTDIR correctLocation
  MessageBox MB_OK|MB_ICONEXCLAMATION "An existing EP128emu installation is registered at $ExistingDir. Please select that folder for the upgrade. To move it, uninstall the previous version first."
  Abort
  correctLocation:
FunctionEnd
Section "EP128emu, ROMs and tools" SecMain
  Delete "$INSTDIR\A02-SOURCE-PROOF.txt"
  Delete "$INSTDIR\SHA256SUMS"
  Delete "$INSTDIR\CHECKSUMS.sha256"
  Delete "$INSTDIR\README"
  Delete "$INSTDIR\README.txt"
  Delete "$INSTDIR\NEWS"
  Delete "$INSTDIR\README_WIN64_TRIAL.txt"
  Delete "$INSTDIR\W01B_DND_FIX.txt"
  Delete "$INSTDIR\W01C_RAR_ROM_FIX.txt"
  Delete "$INSTDIR\W01D_AUTORUN_FIX.txt"
  Delete "$INSTDIR\W01E_AUTORUN_FIX.txt"
  Delete "$INSTDIR\W01F_AUDIO_AND_MINIMAL_VIDEO.txt"
  Delete "$INSTDIR\W01G_FOREGROUND_FOCUS.txt"
  Delete "$INSTDIR\W02A_EF01_03_ACCEPTED_MAC_PORT.txt"
  Delete "$INSTDIR\W02B_EF04E_RELAY_AND_MOTOR.txt"
  Delete "$INSTDIR\W03_EF05B_EF06C.txt"
  Delete "$INSTDIR\W04_EF07H_SPECCYDOS.txt"
  Delete "$INSTDIR\W05_EF08_BETADISK.txt"
