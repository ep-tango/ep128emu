  File /oname=WD1772.rom "${EP128EMU_STAGE}\SpeccyDOS\WD1772.rom"
  SetOutPath "$INSTDIR"
  SetOverwrite off
  SetOutPath "$INSTDIR\config"
  File /oname=clearkbd.cfg "${EP128EMU_STAGE}\config\clearkbd.cfg"
  File /oname=ep_keys.cfg "${EP128EMU_STAGE}\config\ep_keys.cfg"
  SetOutPath "$INSTDIR\disk"
  File /oname=disk.zip "${EP128EMU_STAGE}\disk\disk.zip"
