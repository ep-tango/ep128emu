OBJCC = /usr/bin/clang
CC = /usr/bin/clang
CXX = /usr/bin/clang++
LD = /usr/bin/clang++
AR = /usr/bin/ar
GCC_OPTS = -O2 -arch arm64 -mmacosx-version-min=11.0 -Wno-import -Wno-multichar -Wno-deprecated-declarations
OBJC_OPTS = -std=gnu99
C_OPTS = -std=gnu99
CXX_OPTS = -std=gnu++14
AUTODEPENDENCY_CFLAGS=-MMD -MF$(@:.o=.d) -MT$@
ALL_OBJCFLAGS = $(OBJC_OPTS) $(GCC_OPTS) $(CFLAGS) $(OBJCFLAGS)
ALL_CFLAGS = $(C_OPTS) $(GCC_OPTS) $(CFLAGS)
ALL_CXXFLAGS = $(CXX_OPTS) $(GCC_OPTS) $(CXXFLAGS)
LIBS = -framework Foundation -framework Carbon -lz -lbz2 -lobjc -lc++ -lm
ALL_LDFLAGS = -arch arm64 -mmacosx-version-min=11.0 -ObjC $(LDFLAGS)
SOURCE_DIR = .
BUILD_DIR = Build-ep128emu-arm64
PLATFORM_OBJC_FILES = XADPlatformMacOSX.m XADStringCFString.m

include Makefile.common

LIBRARY_C_FILES += wavpack/common_utils.c wavpack/decorr_utils.c wavpack/entropy_utils.c \
                   wavpack/open_legacy.c wavpack/open_utils.c wavpack/read_words.c \
                   wavpack/tags.c wavpack/unpack.c wavpack/unpack_floats.c \
                   wavpack/unpack_seek.c wavpack/unpack_utils.c

all: unar

libXADMaster.a: $(LIBRARY_OBJS)
	rm -f $@
	$(AR) rcs $@ $^

../UniversalDetector/libUniversalDetector.a:
	$(MAKE) -C ../UniversalDetector -f Makefile.ep128emu-arm64

unar: $(UNAR_OBJS) $(CMDLINE_OBJS) libXADMaster.a ../UniversalDetector/libUniversalDetector.a
	$(LD) $(ALL_LDFLAGS) -o $@ $^ $(LIBS)

.SUFFIXES: .o .c .m .cpp

$(BUILD_DIR)/%.o: $(SOURCE_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(ALL_CFLAGS) $(AUTODEPENDENCY_CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: $(SOURCE_DIR)/%.m
	@mkdir -p $(dir $@)
	$(OBJCC) $(ALL_OBJCFLAGS) $(AUTODEPENDENCY_CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: $(SOURCE_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(ALL_CXXFLAGS) $(AUTODEPENDENCY_CFLAGS) -c $< -o $@

-include $(OBJS:.o=.d)
