#!/bin/sh
set -eu
PREFIX="${EP128EMU_FLTK_PREFIX:-$HOME/Library/ep128emu/fltk-1.4.5}"
REAL="${EP128EMU_FLTK_CONFIG:-$PREFIX/bin/fltk-config}"
SDK="$(xcrun --show-sdk-path)"
OUT="$("$REAL" "$@")"
OUT="$(printf '%s' "$OUT" | sed "s#/Library/Developer/CommandLineTools/SDKs/MacOSX12\\.sdk#$SDK#g")"
# FLTK 1.4.5 emits "-weak_framework UniformTypeIdentifiers".
# SCons ParseConfig() can misinterpret the framework name as an implicit file
# dependency; pass it through the linker explicitly instead.
OUT="$(printf '%s' "$OUT" | sed 's/-weak_framework UniformTypeIdentifiers/-Wl,-weak_framework,UniformTypeIdentifiers/g')"
case " $* " in
  *" --ldflags "*)
    # Runtime FLTK must come from the pinned 1.4.5 prefix, not Homebrew.
    ;;
esac
printf '%s\n' "$OUT"
